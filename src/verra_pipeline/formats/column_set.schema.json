{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "column_set.schema.json",
  "title": "Verra pipeline shared column set",
  "description": "Columns that several tables share. A table pulls them in with \"include\": [\"<name>\"].",
  "type": "object",
  "required": ["name", "description", "columns"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "$ref": "table.schema.json#/$defs/identifier",
      "description": "The set's name. Must match the file name without .json."
    },
    "description": { "$ref": "table.schema.json#/$defs/text" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "table.schema.json#/$defs/column" }
    }
  }
}
